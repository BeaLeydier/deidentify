*! pii_surfaces -- how much sits on each non-value PII surface of every dataset (read-only).
* One call for the whole package; writes four tabs of the review workbook:
*   pii_surfaces       one row per dataset: variables, string variables, notes (count, size),
*                      characteristics (hand-written vs machine-generated by reshape/xi/tsset),
*                      value-label sets/entries and flagged entries, variable labels with a
*                      direct-identifier term, labels/notes holding a file path
*   dataset_notes      every dataset/variable note and characteristic, full text
*   value_label_flags  value-label entries with a direct-identifier term or > 40 characters
*   id_candidates      variables NOT in the user's ID inventory whose name looks like an id
*                      (*id, *_id*, *code*, *key*, *uuid*, *serial*) or that uniquely identify
*                      rows: for the user to accept into the inventory or reject
* and reports whether any do-file READS notes or characteristics (notes list, char list,
* _dta[...]): if none does, notes can be removed without touching the code.
*
*   pii_surfaces, datasets(<list file>) [root(<dir>)] workbook(<xlsx>) ///
*       [dofiles(<list file>) idvars("<inventory names / globs>")]
* List files hold one path per line (spaces allowed), relative to root() unless absolute.
* See references/pii-surfaces.md for the checklist (A-D).
program define pii_surfaces, rclass
    version 16
    syntax , DATAsets(string) WORKbook(string) [ROOT(string) DOfiles(string) IDVars(string)]
    if "`root'"!="" & substr("`root'", -1, 1)!="/" local root "`root'/"
    local PATHRX "[A-Za-z]:\\|/Users/|/home/|Dropbox|\.dta|\.do"

    * ---- do-files that read notes or characteristics ----
    local nreaders = 0
    local readers ""
    if "`dofiles'" != "" {
        mata: _ps_readers(st_local("dofiles"), st_local("root"))
    }

    tempfile S N L I
    tempname FS FN FL FI
    file open `FS' using `S', write replace
    file write `FS' "dataset,dataset_label,n_variables,n_string_vars,n_notes,notes_total_chars,n_char_handwritten,n_char_machine,n_value_label_sets,n_value_label_entries,n_value_label_entries_flagged,n_var_labels_with_direct_term,n_labels_or_notes_with_path" _n
    file open `FN' using `N', write replace
    file write `FN' "dataset,kind,name,number,n_chars,text" _n
    file open `FL' using `L', write replace
    file write `FL' "dataset,value_label,value,label_text,why" _n
    file open `FI' using `I', write replace
    file write `FI' "dataset,variable,name_looks_like_id,uniquely_ids_rows,decision" _n

    tempname IN
    file open `IN' using "`datasets'", read text
    file read `IN' line
    while r(eof)==0 {
        local rel = strtrim(`"`line'"')
        if `"`rel'"' == "" {
            file read `IN' line
            continue
        }
        local d `"`rel'"'
        if !ustrregexm(`"`d'"', "^(/|[A-Za-z]:)") local d `"`root'`d'"'
        quietly use `"`d'"', clear
        local dlab : data label
        mata: st_local("dlab", _ps_clean(st_local("dlab")))
        quietly ds
        local allv `r(varlist)'
        local nv : word count `allv'
        quietly ds, has(type string)
        local ns : word count `r(varlist)'
        local nnotes = 0
        local nchars = 0
        local npath = 0
        * ---- notes (dataset and variable) ----
        foreach o in _dta `allv' {
            local nn : char `o'[note0]
            if "`nn'"=="" continue
            forvalues i = 1/`nn' {
                local t : char `o'[note`i']
                mata: st_local("t", _ps_clean(st_local("t")))
                local ++nnotes
                local len = strlen(`"`t'"')
                local nchars = `nchars' + `len'
                if regexm(`"`t'"', "`PATHRX'") local ++npath
                local kind = cond("`o'"=="_dta", "dataset note", "variable note")
                file write `FN' `""`rel'","`kind'","`o'",`i',`len',"`t'""' _n
            }
        }
        * ---- characteristics other than notes ----
        local nhand = 0
        local nmach = 0
        foreach o in _dta `allv' {
            local clist : char `o'[]
            foreach c of local clist {
                if regexm("`c'","^note[0-9]*$") continue
                local t : char `o'[`c']
                mata: st_local("t", _ps_clean(st_local("t")))
                * machine-generated by reshape/xi/tsset/merge bookkeeping
                if regexm("`c'","^(__|ReS_|_TS|_lang|_dta|destring)") {
                    local ++nmach
                    continue
                }
                local ++nhand
                if regexm(`"`t'"', "`PATHRX'") local ++npath
                file write `FN' `""`rel'","characteristic (hand-written)","`o'[`c']",,`=strlen(`"`t'"')',"`t'""' _n
            }
        }
        * ---- variable labels with a direct-identifier term or a path ----
        local nvl = 0
        foreach v of local allv {
            local l : variable label `v'
            mata: st_local("l", _ps_clean(st_local("l")))
            if ustrregexm(strlower(`"`l'"'), "(^|[^a-z])(name|dob|birth|address|phone|contact|mobile|cnic|national id|email|caste|gps|latitude|longitude)") local ++nvl
            if regexm(`"`l'"', "`PATHRX'") local ++npath
        }
        * ---- value labels ----
        local nsets = 0
        local nent = 0
        local nflag = 0
        quietly label dir
        foreach s in `r(names)' {
            local ++nsets
            quietly label list `s'
            local nent = `nent' + r(k)
            mata: _ps_vlabel("`s'")
            local nflag = `nflag' + `vlflag'
            forvalues j = 1/`vlflag' {
                file write `FL' `""`rel'","`s'",`vlval`j'',"`vltxt`j''","`vlwhy`j''""' _n
            }
        }
        * ---- id candidates not in the inventory ----
        foreach v of local allv {
            local listed = 0
            foreach k of local idvars {
                if strmatch("`v'", "`k'") local listed = 1
            }
            if `listed' continue
            local lv = strlower("`v'")
            local nm = strmatch("`lv'","*id") | strmatch("`lv'","*_id*") | strmatch("`lv'","*code*") ///
                | strmatch("`lv'","*key*") | strmatch("`lv'","*uuid*") | strmatch("`lv'","*serial*")
            capture isid `v'
            local uq = (_rc==0) & _N > 1
            if `nm' | `uq' file write `FI' `""`rel'","`v'",`nm',`uq',"""' _n
        }
        file write `FS' `""`rel'","`dlab'",`nv',`ns',`nnotes',`nchars',`nhand',`nmach',`nsets',`nent',`nflag',`nvl',`npath'"' _n
        file read `IN' line
    }
    file close `IN'
    foreach h in FS FN FL FI {
        file close ``h''
    }
    foreach t in S N L I {
        local sheet = cond("`t'"=="S","pii_surfaces",cond("`t'"=="N","dataset_notes",cond("`t'"=="L","value_label_flags","id_candidates")))
        import delimited using "``t''", varnames(1) clear stringcols(_all) bindquote(strict) maxquotedrows(unlimited)
        if _N == 0 set obs 1
        export excel using "`workbook'", sheet("`sheet'") sheetreplace firstrow(variables)
    }
    di as txt "pii_surfaces: do-files reading notes/characteristics: `nreaders'`readers'"
    return scalar n_notes_readers = `nreaders'
    return local notes_readers "`readers'"
end

mata:
// text safe for a CSV field and a Stata macro: quotes, backticks, commas, control bytes
string scalar _ps_clean(string scalar t)
{
    t = ustrfix(t, "?")
    t = subinstr(subinstr(subinstr(t, char(96), "'"), char(34), "'"), ",", ";")
    t = subinstr(t, char(39), uchar(8217))
    return(ustrregexra(t, "[\x00-\x1F]", " "))
}

// value label lbl: locals vlflag, vlval#, vltxt#, vlwhy# for flagged entries
void _ps_vlabel(string scalar lbl)
{
    real colvector vals
    string colvector txt
    real scalar i, n
    string scalar t, why
    st_vlload(lbl, vals, txt)
    n = 0
    for (i=1; i<=rows(vals); i++) {
        t = strlower(txt[i]); why = ""
        if (ustrregexm(t, "(^|[^a-z])(name|dob|birth|address|phone|contact|mobile|cnic|national id|email|caste|gps|latitude|longitude)")) why = "direct-identifier term"
        else if (strlen(t) > 40) why = "long free text (>40 chars)"
        if (why != "") {
            n++
            st_local("vlval" + strofreal(n), strofreal(vals[i]))
            st_local("vltxt" + strofreal(n), _ps_clean(substr(txt[i], 1, 120)))
            st_local("vlwhy" + strofreal(n), why)
        }
    }
    st_local("vlflag", strofreal(n))
}

// do-files (list file) whose code reads notes or characteristics -> locals nreaders, readers
void _ps_readers(string scalar listfile, string scalar root)
{
    string colvector F, L
    real scalar f, i, n
    string scalar who, p
    F = select(cat(listfile), strtrim(cat(listfile)) :!= "")
    n = 0; who = ""
    for (f=1; f<=rows(F); f++) {
        p = strtrim(F[f])
        if (!ustrregexm(p, "^(/|[A-Za-z]:)")) p = root + p
        if (!fileexists(p)) continue
        L = cat(p)
        for (i=1; i<=rows(L); i++) {
            if (ustrregexm(L[i], "^[ \t]*\*")) continue
            if (ustrregexm(L[i], "^[ \t]*(notes?([ \t]+(list|search))?[ \t]*$|notes?[ \t]+(list|search)[ \t]|char[ \t]+(list|dir))|_dta\[")) {
                n++
                who = who + " " + pathbasename(p)
                break
            }
        }
    }
    st_local("nreaders", strofreal(n))
    st_local("readers", who)
}
end
